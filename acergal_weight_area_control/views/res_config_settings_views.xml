<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_weight_area" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.weight.area</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Control peso-área">
                    <setting string="Umbral global de variación"
                             help="Alerta visual si la desviación del factor real supera este porcentaje.">
                        <field name="weight_area_variance_threshold_pct"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
